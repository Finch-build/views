{
  "productName": "views",
  "mainBinaryName": "views-settings",
  "identifier": "dev.finch.views",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "views", "width": 960, "height": 720, "minWidth": 640, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
